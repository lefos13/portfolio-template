---
interface Props {
  ariaLabel?: string;
}

const { ariaLabel = 'Project highlights' } = Astro.props;
---

<section class="bubble-grid" aria-label={ariaLabel}>
  <slot />
</section>

<style>
  .bubble-grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
    grid-template-columns: 1fr;
  }

  @media (min-width: 520px) {
    .bubble-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .bubble-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .bubble-grid :global(.bubble) {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--duration-base) ease,
      background-color var(--duration-base) ease,
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) ease;
  }

  .bubble-grid :global(.bubble:hover) {
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .bubble-grid :global(.bubble h3) {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-heading);
  }

  .bubble-grid :global(.bubble p) {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble-grid :global(.bubble) {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
