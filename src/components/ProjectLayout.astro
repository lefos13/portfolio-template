---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

interface Props {
	title: string;
	description: string;
	repoUrl: string;
	ctaLabel?: string;
	theme?: 'blue' | 'purple' | 'teal';
	darkMode?: boolean;
}

const { title, description, repoUrl, ctaLabel = 'View Repository', theme = 'blue', darkMode = false } = Astro.props;

const themeColors = {
	blue: {
		primary: 'rgba(75, 99, 255, 0.18)',
		secondary: 'rgba(13, 148, 136, 0.18)',
		tertiary: 'rgba(64, 224, 208, 0.16)',
		accent: '#4b63ff',
		gradient: 'linear-gradient(135deg, #4b63ff, #16a085)',
	},
	purple: {
		primary: 'rgba(78, 205, 196, 0.18)',
		secondary: 'rgba(187, 134, 252, 0.18)',
		tertiary: 'rgba(94, 234, 212, 0.12)',
		accent: '#7c3aed',
		gradient: 'linear-gradient(135deg, #4b63ff, #7c3aed)',
	},
	teal: {
		primary: 'rgba(59, 130, 246, 0.18)',
		secondary: 'rgba(236, 72, 153, 0.2)',
		tertiary: 'rgba(56, 189, 248, 0.12)',
		accent: '#2563eb',
		gradient: 'linear-gradient(135deg, #2563eb, #ec4899)',
	},
};

const colors = themeColors[theme];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class:list={[darkMode && 'dark-mode']}>
		<Header />
		<main class="page">
			<div class="background" aria-hidden="true"></div>
			<section class="hero">
				<p class="eyebrow">Project Spotlight</p>
				<h1>{title}</h1>
				<p class="lead">{description}</p>
				<div class="cta-group">
					<a class="button" href={repoUrl} target="_blank" rel="noopener">{ctaLabel}</a>
					<a class="ghost" href="#content">Learn More</a>
				</div>
			</section>

			<section class="content" id="content">
				<slot />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style define:vars={{ 
	primary: colors.primary, 
	secondary: colors.secondary, 
	tertiary: colors.tertiary,
	accent: colors.accent,
	gradient: colors.gradient
}}>
	body {
		background: radial-gradient(circle at 20% 20%, var(--primary), transparent 60%),
			radial-gradient(circle at 80% 10%, var(--tertiary), transparent 55%),
			radial-gradient(circle at 50% 80%, var(--secondary), transparent 60%);
		min-height: 100vh;
	}

	body.dark-mode {
		background: radial-gradient(circle at 15% 20%, var(--primary), transparent 60%),
			radial-gradient(circle at 90% 15%, var(--tertiary), transparent 55%),
			radial-gradient(circle at 50% 80%, var(--secondary), transparent 60%);
	}

	.page {
		position: relative;
		margin: 0 auto;
		max-width: 1100px;
		padding: 4rem 1rem 5rem;
		color: #101828;
		width: 100%;
		box-sizing: border-box;
		overflow-x: hidden;
	}

	.background {
		position: fixed;
		inset: 0;
		background: linear-gradient(120deg, var(--primary), var(--secondary));
		filter: blur(140px);
		opacity: 0.6;
		pointer-events: none;
		z-index: -2;
		animation: pulse 14s ease-in-out infinite alternate;
	}

	@keyframes pulse {
		0% {
			transform: scale(1) translateY(0);
		}
		50% {
			transform: scale(1.05) translateY(-10px);
		}
		100% {
			transform: scale(0.98) translateY(6px);
		}
	}

	.hero {
		margin-bottom: 3rem;
		text-align: center;
	}

	.eyebrow {
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	.lead {
		font-size: 1.15rem;
		line-height: 1.75;
		margin: 1rem auto 0;
		max-width: 60ch;
		color: #1f2937;
	}

	body.dark-mode .lead {
		color: black;
	}

	.cta-group {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 2rem;
	}

	.button,
	.ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 1.6rem;
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
	}

	.button {
		background: var(--gradient);
		color: #fff;
		box-shadow: 0 10px 30px rgba(75, 99, 255, 0.35);
	}

	.button:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 32px rgba(75, 99, 255, 0.45);
	}

	.ghost {
		background: rgba(255, 255, 255, 0.3);
		color: var(--accent);
		border: 1px solid rgba(75, 99, 255, 0.2);
	}

	.ghost:hover {
		background: rgba(75, 99, 255, 0.12);
		transform: translateY(-2px);
	}

	.content {
		backdrop-filter: blur(12px);
		background: rgba(255, 255, 255, 0.78);
		border-radius: 2rem;
		padding: 3rem clamp(1.5rem, 4vw, 3.5rem);
		box-shadow: 0 30px 70px rgba(15, 23, 42, 0.12);
	}

	body.dark-mode .content {
		background: rgba(15, 23, 42, 0.82);
		box-shadow: 0 30px 70px rgba(15, 23, 42, 0.3);
		color: #f8fafc;
	}

	.content :global(h2),
	.content :global(h3),
	.content :global(h4) {
		margin-top: 2.2rem;
		color: #0f172a;
	}

	body.dark-mode .content :global(h2),
	body.dark-mode .content :global(h3),
	body.dark-mode .content :global(h4) {
		color: #000000;
	}

	.content :global(ul) {
		margin: 1rem 0 1.5rem;
		padding-left: 1.2rem;
	}

	.content :global(p) {
		margin: 1rem 0;
	}

	.content :global(.cta) {
		border-left: 3px solid var(--accent);
		margin-top: 2.5rem;
		padding-left: 1rem;
		font-weight: 500;
		color: #1f2937;
	}

	body.dark-mode .content :global(.cta) {
		color: #000000;
	}

	@media (prefers-reduced-motion: reduce) {
		.background,
		.button,
		.ghost {
			animation: none !important;
			transition: none !important;
		}
	}
	
	@media (max-width: 1024px) {
		.page {
			padding: 3rem 1rem 4rem;
			width: 100%;
		}
		
		.hero {
			margin-bottom: 2.5rem;
		}
		
		.content {
			padding: 2.5rem clamp(1rem, 3vw, 2rem);
		}
	}
	
	@media (max-width: 768px) {
		.page {
			padding: 2.5rem 0.75rem 3rem;
			width: 100%;
		}
		
		.hero {
			margin-bottom: 2rem;
		}
		
		.hero h1 {
			font-size: 2rem;
			line-height: 1.2;
		}
		
		.eyebrow {
			font-size: 0.8rem;
			margin-bottom: 0.5rem;
		}
		
		.lead {
			font-size: 1rem;
			line-height: 1.6;
			margin-top: 0.75rem;
		}
		
		.cta-group {
			flex-direction: column;
			width: 100%;
			max-width: 400px;
			margin: 1.5rem auto 0;
		}
		
		.button,
		.ghost {
			width: 100%;
			padding: 0.75rem 1.4rem;
			font-size: 0.95rem;
		}
		
		.content {
			padding: 2rem 1.5rem;
			border-radius: 1.5rem;
		}
		
		.content :global(h2) {
			font-size: 1.75rem;
			margin-top: 2rem;
		}
		
		.content :global(h3) {
			font-size: 1.4rem;
			margin-top: 1.75rem;
		}
		
		.content :global(h4) {
			font-size: 1.2rem;
		}
		
		.content :global(p) {
			font-size: 0.95rem;
		}
		
		.content :global(ul) {
			padding-left: 1rem;
		}
		
		.content :global(li) {
			font-size: 0.95rem;
			margin-bottom: 0.5rem;
		}
	}
	
	@media (max-width: 480px) {
		.page {
			padding: 2rem 0.5rem 2.5rem;
			width: 100%;
		}
		
		.hero h1 {
			font-size: 1.75rem;
		}
		
		.eyebrow {
			font-size: 0.75rem;
		}
		
		.lead {
			font-size: 0.95rem;
		}
		
		.button,
		.ghost {
			padding: 0.7rem 1.2rem;
			font-size: 0.9rem;
		}
		
		.content {
			padding: 1.5rem 1.25rem;
			border-radius: 1.25rem;
		}
		
		.content :global(h2) {
			font-size: 1.5rem;
			margin-top: 1.75rem;
		}
		
		.content :global(h3) {
			font-size: 1.25rem;
			margin-top: 1.5rem;
		}
		
		.content :global(h4) {
			font-size: 1.1rem;
		}
		
		.content :global(p),
		.content :global(li) {
			font-size: 0.9rem;
		}
		
		.content :global(.cta) {
			padding-left: 0.75rem;
			margin-top: 2rem;
			font-size: 0.9rem;
		}
	}
</style>
