---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  repoUrl: string;
  ctaLabel?: string;
}

const {
  title,
  description,
  repoUrl,
  ctaLabel = 'View Repository',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="project-page">
    <div class="glow-bg" aria-hidden="true"></div>

    <section class="hero">
      <div class="container">
        <p class="eyebrow">Project Spotlight</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="cta-group">
          <a class="btn btn--primary" href={repoUrl} target="_blank" rel="noopener">
            {ctaLabel}
          </a>
          <a class="btn btn--ghost" href="#content">Learn More</a>
        </div>
      </div>
    </section>

    <div class="container container--narrow">
      <section class="content" id="content">
        <slot />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .project-page {
    position: relative;
    overflow: hidden;
    padding-bottom: var(--space-9);
  }

  .glow-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: var(--container-max);
    height: 32rem;
    background:
      radial-gradient(ellipse 60% 45% at 50% 0%, var(--color-glow), transparent 70%),
      radial-gradient(ellipse 40% 35% at 80% 20%, var(--color-glow-alt), transparent 60%);
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  .hero {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .hero h1 {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
    max-width: 44rem;
    margin-inline: auto;
  }

  .hero .lead {
    margin-inline: auto;
    max-width: 42rem;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .content {
    position: relative;
    z-index: 1;
    padding-top: var(--space-4);
  }

  /* Highlight cards break out of the narrow prose column to the full container width. */
  .content :global(.bubble-grid) {
    --breakout: min(var(--container-max), 100vw - 2 * var(--container-pad));
    width: var(--breakout);
    margin-inline: calc((100% - var(--breakout)) / 2);
  }

  .content :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    color: var(--color-heading);
  }

  .content :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    color: var(--color-heading);
  }

  .content :global(h4) {
    font-size: var(--text-lg);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--color-heading);
  }

  .content :global(p) {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .content :global(ul) {
    margin: var(--space-4) 0 var(--space-6);
    padding-left: 1.25rem;
  }

  .content :global(li) {
    color: var(--color-text);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-2);
  }

  .content :global(.cta),
  .content :global(p.cta) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-6);
    padding: var(--space-5) var(--space-6);
    background: var(--color-accent-soft);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-heading);
    font-weight: 500;
  }

  .content :global(.project-links) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .content :global(.website-link),
  .content :global(.repo-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.875rem;
    padding: 0 var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .content :global(.website-link) {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .content :global(.website-link:hover) {
    background: var(--color-accent-strong);
    color: var(--color-accent-contrast);
  }

  .content :global(.repo-link) {
    background: transparent;
    border-color: var(--color-border-strong);
    color: var(--color-heading);
  }

  .content :global(.repo-link:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .cta-group {
      flex-direction: column;
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
    }

    .cta-group .btn {
      width: 100%;
    }

    .content :global(.project-links) {
      flex-direction: column;
    }

    .content :global(.website-link),
    .content :global(.repo-link) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow-bg {
      animation: none !important;
    }

    .content :global(.website-link),
    .content :global(.repo-link) {
      transition: none !important;
    }
  }
</style>
