          >
            <path
              d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"
            ></path>
          </svg>
        </Link>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.querySelector(".mobile-menu-toggle");
    const navContainer = document.querySelector(".nav-container");

    if (toggle && navContainer) {
      toggle.addEventListener("click", () => {
        const isActive = navContainer.classList.toggle("active");
        toggle.classList.toggle("active", isActive);

        // Disable/enable body scrolling
        if (isActive) {
          document.body.classList.add("menu-open");
        } else {
          document.body.classList.remove("menu-open");
        }
      });

      // Close menu when clicking a link
      const links = navContainer.querySelectorAll("a");
      links.forEach((link) => {
        link.addEventListener("click", () => {
          navContainer.classList.remove("active");
          toggle.classList.remove("active");
          document.body.classList.remove("menu-open");
        });
      });

      // Close menu when clicking outside (on mobile)
      document.addEventListener("click", (e) => {
        const target = e.target as Node;
        if (
          window.innerWidth <= 900 &&
          !navContainer.contains(target) &&
          !toggle.contains(target) &&
          navContainer.classList.contains("active")
        ) {
          navContainer.classList.remove("active");
          toggle.classList.remove("active");
          document.body.classList.remove("menu-open");
        }
      });
    }
  });
</script>
<style>
  .dropdown {
    position: relative;
    display: inline-flex;
  }
  .dropdown-label {
    cursor: pointer;
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    font-weight: 500;
    user-select: none;
  }
  .dropdown-content {
    display: none;
    position: absolute;
    background: white;
    min-width: 180px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    z-index: 10;
    margin-top: 0.2em;
    border-radius: 0.25em;
    padding: 0.5em 0;
    transition: max-height 0.2s ease;
    overflow: hidden;
    top: 50px;
  }
  .dropdown:hover .dropdown-content,
  .dropdown:focus-within .dropdown-content {
    display: block;
  }
  .dropdown-content a {
    display: block;
    padding: 0.7em 1.2em;
    color: var(--black);
    text-decoration: none;
    border-bottom: none;
    font-size: 1em;
  }
  .dropdown-content a:hover {
    background: #f5f7fa;
    color: var(--accent);
  }
</style>
<style is:global>
  /* Hide accordion on desktop (min-width: 901px) */
  .accordion.mobile-only {
    display: none;
  }
  /* Hide dropdown on mobile (max-width: 900px) */
  @media (max-width: 900px) {
    .accordion {
      padding: 16px 24px;
    }
    .accordion .content {
      padding-block-end: 0 !important;
    }
    .accordion .heading {
      font-size: 16px;
      font-weight: normal;
    }

    h6.heading {
      font-size: 16px !important;
      font-weight: normal !important;
      margin: 0;
    }

    summary.title {
      padding: 10px 0;
      border-left: 4px solid transparent;
    }
    .accordion-links {
      padding-left: 10px;
      list-style: none;
    }
    .dropdown {
      display: none !important;
    }
    .dropdown.desktop-only {
      display: none !important;
    }
    .accordion.mobile-only {
      display: block !important;
      width: 100%;
      margin: 0;
    }
    /* Style the accordion content links */
    .accordion-links {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .accordion-links a {
      display: block;
      padding: 0.85rem 1.5rem;
      color: var(--black);
      text-decoration: none;
      border-bottom: 1px solid #e8e8e8;
      font-size: 1em;
      background: none;
      transition:
        background 0.2s,
        color 0.2s;
    }
    .accordion-links a:last-child {
      border-bottom: none;
    }
    .accordion-links a:hover {
      background: #f5f7fa;
      color: var(--accent);
    }
  }
</style>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 101;
  }

  .hamburger {
    display: block;
    width: 28px;
    height: 2px;
    background: rgb(var(--black));
    position: relative;
    transition: all 0.3s ease;
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    width: 28px;
    height: 2px;
    background: rgb(var(--black));
    transition: all 0.3s ease;
  }

  .hamburger::before {
    top: -8px;
  }

  .hamburger::after {
    bottom: -8px;
  }

  .mobile-menu-toggle.active .hamburger {
    background: transparent;
  }

  .mobile-menu-toggle.active .hamburger::before {
    transform: rotate(45deg);
    top: 0;
  }

  .mobile-menu-toggle.active .hamburger::after {
    transform: rotate(-45deg);
    bottom: 0;
  }

  .nav-container {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .internal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  nav a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  .social-links {
    gap: 0.75rem;
    align-items: center;
  }
  .social-links a {
    color: #64748b;
    transition: all 0.2s ease;
    padding: 0.4rem;
    border-radius: 0.5rem;
  }
  .social-links a:hover {
    color: var(--accent);
    background: rgba(99, 102, 241, 0.08);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .mobile-menu-toggle {
      display: block;
    }
    .nav-container {
      position: fixed;
      top: 0;
      right: -100%;
      width: 280px;
      height: 100vh;
      background: white;
      box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 5rem 0 2rem;
      transition: right 0.3s ease;
      overflow-y: auto;
    }
    .nav-container.active {
      right: 0;
    }
    .internal-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
    }
    .internal-links a {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid #f0f0f0;
      border-left: 4px solid transparent;
    }
    .internal-links a:hover,
    .internal-links a.active {
      background: #f8f9fa;
      border-left-color: var(--accent);
      border-bottom-color: #f0f0f0;
    }
    /* Ensure accordion integrates with the mobile nav styling */
    .accordion.mobile-only {
      border-bottom: 1px solid #f0f0f0;
    }
    .dropdown {
      width: 100%;
    }
    .dropdown-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid #f0f0f0;
      width: 100%;
      background: none;
      border: none;
      font-size: 1em;
    }
    .dropdown-content {
      position: static;
      display: none;
      box-shadow: none;
      background: #f8f9fa;
      margin: 0;
      border-radius: 0;
      padding: 0;
    }
    .dropdown.open .dropdown-content {
      display: block;
    }
    .dropdown-content a {
      padding: 0.85rem 1.5rem 0.85rem 2.5rem;
      border-left: none;
      border-bottom: 1px solid #e8e8e8;
    }
    .arrow {
      transition: transform 0.3s ease;
      display: inline-block;
    }
    .dropdown.open .arrow {
      transform: rotate(180deg);
    }
    .social-links {
      padding: 2rem 1.5rem;
      justify-content: center;
      border-top: 1px solid #f0f0f0;
      margin-top: auto;
    }
  }

  @media (max-width: 720px) {
    header {
      padding: 0 0.75em;
    }

    .nav-container {
      width: 100%;
      right: -100%;
    }

    h2 {
      font-size: 0.95em;
    }
  }
</style>
