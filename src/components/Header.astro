---
import { SITE_TITLE, BASE_URI } from "../consts";
import { projects } from "../data/projects";
import { socialLinks } from "../data/social";

const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { label: "Home", href: `${BASE_URI}` },
  { label: "Timeline", href: `${BASE_URI}/timeline` },
  { label: "About", href: `${BASE_URI}/about` },
];
const inProjects = path.startsWith(`${BASE_URI}/projects`);
---

<header class="site-header">
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="container nav" aria-label="Primary">
    <a class="brand" href={`${BASE_URI}/`}>
      <span class="brand-mark" aria-hidden="true">LE</span>
      <span class="brand-text">{SITE_TITLE}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="sr-only">Toggle navigation menu</span>
      <span class="menu-bar" aria-hidden="true"></span>
    </button>

    <div class="menu" id="site-menu">
      <ul class="menu-links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href === BASE_URI ? `${BASE_URI}/` : link.href}
                aria-current={path === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="dropdown">
          <button
            class="dropdown-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="projects-menu"
            data-active={inProjects ? "true" : undefined}
          >
            Projects
            <svg class="chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul class="dropdown-panel" id="projects-menu">
            {
              projects.map((project) => (
                <li>
                  <a
                    href={project.href}
                    aria-current={path === project.href ? "page" : undefined}
                  >
                    {project.navLabel}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
      </ul>

      <ul class="social">
        {
          socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span class="sr-only">{link.label}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d={link.icon} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const menuToggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = header?.querySelector<HTMLElement>(".menu");
  const dropdownToggle = header?.querySelector<HTMLButtonElement>(".dropdown-toggle");
  const dropdown = header?.querySelector<HTMLElement>(".dropdown");
  const mobile = window.matchMedia("(max-width: 900px)");

  function setMenu(open: boolean, returnFocus = false) {
    if (!menuToggle || !menu) return;
    menuToggle.setAttribute("aria-expanded", String(open));
    menu.classList.toggle("is-open", open);
    document.body.classList.toggle("menu-open", open);
    if (returnFocus) menuToggle.focus();
  }

  function setDropdown(open: boolean, returnFocus = false) {
    if (!dropdownToggle) return;
    dropdownToggle.setAttribute("aria-expanded", String(open));
    if (returnFocus) dropdownToggle.focus();
  }

  menuToggle?.addEventListener("click", () => {
    setMenu(menuToggle.getAttribute("aria-expanded") !== "true");
  });

  dropdownToggle?.addEventListener("click", () => {
    setDropdown(dropdownToggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (dropdownToggle?.getAttribute("aria-expanded") === "true") {
      setDropdown(false, true);
    } else if (menuToggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false, true);
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (dropdown && !dropdown.contains(target) && !mobile.matches) setDropdown(false);
    if (header && !header.contains(target)) setMenu(false);
  });

  dropdown?.addEventListener("focusout", (event) => {
    if (mobile.matches) return;
    if (!dropdown.contains(event.relatedTarget as Node | null)) setDropdown(false);
  });

  mobile.addEventListener("change", () => {
    setMenu(false);
    setDropdown(false);
  });

  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-overlay);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0;
  }

  .menu-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .menu-links > li > a,
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .menu-links > li > a:hover,
  .dropdown-toggle:hover {
    color: var(--color-heading);
    background: var(--color-surface);
  }

  .menu-links > li > a[aria-current="page"],
  .dropdown-toggle[data-active] {
    color: var(--color-heading);
  }

  .menu-links > li > a[aria-current="page"] {
    box-shadow: inset 0 -2px 0 var(--color-accent);
    border-radius: 0;
  }

  .chevron {
    transition: transform var(--duration-fast) ease;
  }

  .dropdown-toggle[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .dropdown {
    position: relative;
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    min-width: 15rem;
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease,
      visibility var(--duration-fast);
  }

  .dropdown-toggle[aria-expanded="true"] + .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .dropdown-panel a {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .dropdown-panel a:hover,
  .dropdown-panel a[aria-current="page"] {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .social {
    display: flex;
    gap: var(--space-1);
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-muted);
    border-radius: var(--radius-pill);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .social a:hover {
    color: var(--color-accent);
    background: var(--color-surface);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    /* backdrop-filter makes the header a containing block for the fixed menu */
    .site-header:has(.menu.is-open) {
      background: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .menu-toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      color: var(--color-heading);
      background: none;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      cursor: pointer;
    }

    .menu-bar,
    .menu-bar::before,
    .menu-bar::after {
      display: block;
      width: 1.125rem;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      transition: transform var(--duration-base) var(--ease-out), opacity var(--duration-fast);
    }

    .menu-bar {
      position: relative;
    }

    .menu-bar::before,
    .menu-bar::after {
      content: "";
      position: absolute;
      left: 0;
    }

    .menu-bar::before {
      top: -6px;
    }

    .menu-bar::after {
      top: 6px;
    }

    .menu-toggle[aria-expanded="true"] .menu-bar {
      background: transparent;
    }

    .menu-toggle[aria-expanded="true"] .menu-bar::before {
      transform: translateY(6px) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] .menu-bar::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .menu {
      position: fixed;
      inset: var(--header-height) 0 0 0;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: var(--space-6);
      padding: var(--space-5) var(--container-pad) var(--space-7);
      overflow-y: auto;
      background: var(--color-bg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity var(--duration-base) ease,
        transform var(--duration-base) var(--ease-out),
        visibility var(--duration-base);
    }

    .menu.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .menu-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .menu-links > li {
      border-bottom: 1px solid var(--color-border);
    }

    .menu-links > li > a,
    .dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: var(--space-4) 0;
      font-family: var(--font-serif);
      font-size: var(--text-xl);
      color: var(--color-heading);
    }

    .menu-links > li > a:hover,
    .dropdown-toggle:hover {
      background: none;
      color: var(--color-accent);
    }

    .menu-links > li > a[aria-current="page"] {
      box-shadow: none;
      color: var(--color-accent);
    }

    .dropdown-panel {
      position: static;
      display: none;
      min-width: 0;
      padding: 0 0 var(--space-4);
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .dropdown-toggle[aria-expanded="true"] + .dropdown-panel {
      display: block;
    }

    .dropdown-panel a {
      padding: var(--space-2) 0;
      font-size: var(--text-base);
    }

    .dropdown-panel a:hover,
    .dropdown-panel a[aria-current="page"] {
      background: none;
    }

    .social {
      justify-content: center;
      gap: var(--space-3);
    }

    .social a {
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-border);
    }
  }
</style>
