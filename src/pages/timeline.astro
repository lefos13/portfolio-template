---
import BaseLayout from "../layouts/BaseLayout.astro";
import content from "../content.json";

const CATEGORY_ICONS: Record<string, string> = {
  Career: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`,
  "Product Delivery": `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>`,
  "Digital Platforms": `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10a7.31 7.31 0 0 0 10 10Z"></path><path d="m9 15 3-3"></path><path d="M17 13a6 6 0 0 0-6-6"></path><path d="M21 13A10 10 0 0 0 11 3"></path></svg>`,
  "Startup Engineering": `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"></circle><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path><circle cx="18" cy="5" r="3"></circle></svg>`,
  "Research & Delivery": `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg>`,
  Education: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>`,
  fallback: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path></svg>`,
};
---

<BaseLayout
  title="Timeline | Lefteris Evangelinos"
  description="Milestones from my software engineering journey"
>
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h1>{content.pages.timeline.header.title}</h1>
        <p>{content.pages.timeline.header.description}</p>
      </div>

      <ol class="timeline">
        {
          content.pages.timeline.milestones.map((milestone) => {
            const iconSvg =
              CATEGORY_ICONS[milestone.category] || CATEGORY_ICONS.fallback;

            return (
              <li class="timeline-item">
                <div class="timeline-marker" aria-hidden="true" />
                <div class="timeline-year">
                  <span class="year-badge">{milestone.year}</span>
                </div>
                <div class="timeline-card card">
                  <div class="timeline-meta">
                    <span class="tag tag--accent category-chip">
                      <Fragment set:html={iconSvg} />
                      <span>{milestone.category}</span>
                    </span>
                  </div>
                  <h2 class="timeline-title">{milestone.title}</h2>
                  <p class="timeline-subtitle">{milestone.subtitle}</p>
                  <p class="timeline-description">{milestone.description}</p>
                  <ul class="tag-list">
                    {milestone.tags.map((tag) => (
                      <li>
                        <span class="tag">{tag}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 64rem;
    margin-inline: auto;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 1rem;
    width: 2px;
    background: var(--color-border);
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-7) 2.5rem;
    min-width: 0;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: 1rem;
    top: 0.35rem;
    transform: translate(-50%, 0);
    width: 0.875rem;
    height: 0.875rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
    z-index: 1;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .timeline-year {
    margin-bottom: var(--space-3);
  }

  .year-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-heading);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }

  .timeline-card {
    padding: var(--space-5);
    min-width: 0;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .category-chip {
    gap: var(--space-2);
    font-weight: 600;
  }

  .category-chip :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .timeline-title {
    font-size: var(--text-xl);
    margin-top: 0;
    margin-bottom: var(--space-1);
    color: var(--color-heading);
    line-height: var(--leading-snug);
  }

  .timeline-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    line-height: var(--leading-normal);
  }

  .timeline-description {
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
  }

  @media (min-width: 640px) {
    .timeline-card {
      padding: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .timeline::before {
      left: 50%;
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-8);
      align-items: start;
      padding-left: 0;
      padding-bottom: var(--space-8);
    }

    .timeline-marker {
      left: 50%;
      top: 1.75rem;
      transform: translate(-50%, -50%);
    }

    /* Odd items (1st, 3rd, 5th, 7th): Card on left, Year badge on right next to rail */
    .timeline-item:nth-child(odd) .timeline-card {
      grid-column: 1;
      grid-row: 1;
    }

    .timeline-item:nth-child(odd) .timeline-year {
      grid-column: 2;
      grid-row: 1;
      justify-self: start;
      margin-top: 1.35rem;
      margin-bottom: 0;
    }

    /* Even items (2nd, 4th, 6th): Year badge on left next to rail, Card on right */
    .timeline-item:nth-child(even) .timeline-year {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      margin-top: 1.35rem;
      margin-bottom: 0;
    }

    .timeline-item:nth-child(even) .timeline-card {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .timeline-item:hover .timeline-marker {
      transform: translate(-50%, 0) scale(1.25);
      box-shadow: 0 0 0 3px var(--color-accent-soft);
    }

    @media (min-width: 1024px) {
      .timeline-item:hover .timeline-marker {
        transform: translate(-50%, -50%) scale(1.25);
      }
    }
  }
</style>
