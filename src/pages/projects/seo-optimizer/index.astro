---
import content from "../../../content.json";
import ProjectLayout from "../../../components/ProjectLayout.astro";
import BubbleGrid from "../../../components/BubbleGrid.astro";
import Bubble from "../../../components/Bubble.astro";
import MetricGrid from "../../../components/MetricGrid.astro";
import Metric from "../../../components/Metric.astro";
import StackGrid from "../../../components/StackGrid.astro";

const project = content.pages.projects["seo-optimizer"];
const pageTitle = project.title;
const pageDescription = project.description;
const repoUrl = "https://github.com/lefos13/SEO-optimizer";
---

<ProjectLayout
  title={pageTitle}
  description={pageDescription}
  repoUrl={repoUrl}
  theme="purple"
>
  <BubbleGrid ariaLabel="SEO Optimizer highlights" theme="purple">
    {
      project.highlights.map((highlight) => (
        <Bubble title={highlight.title}>{highlight.content}</Bubble>
      ))
    }
  </BubbleGrid>

  <h2>What I Built</h2>
  <p>
    {project.whatIBuilt}
  </p>

  <MetricGrid theme="purple">
    {
      project.metrics.map((metric) => (
        <Metric value={metric.value} label={metric.label} />
      ))
    }
  </MetricGrid>

  <h3 id="features">Key Features</h3>
  <ul>
    {project.features.map((feature) => <li>{feature}</li>)}
  </ul>

  <h3>Technical Architecture</h3>
  <p>
    {project.architecture}
  </p>

  <h3>Stack at a Glance</h3>
  <StackGrid theme="purple">
    <div>
      <h4>Core Framework</h4>
      <p>{project.stack.core}</p>
    </div>
    <div>
      <h4>Frontend</h4>
      <p>{project.stack.frontend}</p>
    </div>
    <div>
      <h4>Backend & Analysis</h4>
      <p>{project.stack.backend}</p>
    </div>
  </StackGrid>

  <h3>Developer Experience</h3>
  <p>
    {project.devExperience}
  </p>

  <h3>Outcome</h3>
  <p>
    {project.outcome}
  </p>

  <p class="cta">
    {project.cta}
    <a href={repoUrl} target="_blank" rel="noopener">{repoUrl}</a>.
  </p>
</ProjectLayout>

