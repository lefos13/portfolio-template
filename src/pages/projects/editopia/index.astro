---
import content from "../../../content.json";
import ProjectLayout from "../../../components/ProjectLayout.astro";
import BubbleGrid from "../../../components/BubbleGrid.astro";
import Bubble from "../../../components/Bubble.astro";
import MetricGrid from "../../../components/MetricGrid.astro";
import Metric from "../../../components/Metric.astro";
import StackGrid from "../../../components/StackGrid.astro";

const project = content.pages.projects["editopia"];
const pageTitle = project.title;
const pageDescription = project.description;
const websiteUrl = "https://editopia.gr/";
const repoUrl = "https://github.com/lefos13/elenpapa.github.io";
---

<ProjectLayout
  title={pageTitle}
  description={pageDescription}
  repoUrl={websiteUrl}
>
  <BubbleGrid ariaLabel="Editopia highlights">
    {
      project.highlights.map((highlight) => (
        <Bubble title={highlight.title}>{highlight.content}</Bubble>
      ))
    }
  </BubbleGrid>

  <h2>What I Built</h2>
  <p>
    {project.whatIBuilt}
  </p>

  <MetricGrid>
    {
      project.metrics.map((metric) => (
        <Metric value={metric.value} label={metric.label} />
      ))
    }
  </MetricGrid>

  <h3 id="features">Key Features</h3>
  <ul>
    {project.features.map((feature) => <li>{feature}</li>)}
  </ul>

  <h3>Technical Architecture</h3>
  <p>
    {project.architecture}
  </p>

  <h3>Stack at a Glance</h3>
  <StackGrid>
    <div>
      <h4>Core Framework</h4>
      <p>{project.stack.core}</p>
    </div>
    <div>
      <h4>Styling</h4>
      <p>{project.stack.styling}</p>
    </div>
    <div>
      <h4>Deployment</h4>
      <p>{project.stack.deployment}</p>
    </div>
  </StackGrid>

  <h3>Developer Experience</h3>
  <p>
    {project.devExperience}
  </p>

  <h3>Outcome</h3>
  <p>
    {project.outcome}
  </p>

  <p class="cta">
    {project.cta}
  </p>

  <div class="project-links">
    <a href={websiteUrl} target="_blank" rel="noopener" class="website-link">
      🌐 Visit Editopia.gr
    </a>
    <a href={repoUrl} target="_blank" rel="noopener" class="repo-link">
      📂 View Source Code
    </a>
  </div>
</ProjectLayout>

<style>
  .project-links {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .website-link,
  .repo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.875rem;
    padding: 0 var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .website-link {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .website-link:hover {
    background: var(--color-accent-strong);
    color: var(--color-accent-contrast);
  }

  .repo-link {
    background: transparent;
    border-color: var(--color-border-strong);
    color: var(--color-heading);
  }

  .repo-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .project-links {
      flex-direction: column;
    }

    .website-link,
    .repo-link {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .website-link,
    .repo-link {
      transition: none !important;
    }
  }
</style>
