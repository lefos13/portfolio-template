---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BASE_URI } from "../consts";
import content from "../content.json";

const { whoIAm, technicalJourney, literaryWork, bringingItTogether } =
  content.pages.about;
---

<BaseLayout
  title="About Me"
  description="Full-stack developer, software engineer, and fantasy author"
>
  <section class="section about-hero">
    <div class="container about-hero__container">
      <div class="about-hero__content">
        <h1 class="about-hero__title">About Me</h1>
      </div>
      <div class="about-hero__media">
        <img
          src={`${BASE_URI}/images/avatar.jpg`}
          alt="Lefteris Evangelinos"
          width="903"
          height="903"
          class="about-hero__avatar"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-body">
      <h2>{whoIAm.title}</h2>
      <p>{whoIAm.content}</p>
      <p>{whoIAm.education}</p>
      <div class="callout about-philosophy">
        <strong>{whoIAm.philosophy}</strong>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-body">
      <h2>{technicalJourney.title}</h2>
      <img
        src={`${BASE_URI}/images/codingAvatar.jpg`}
        alt="Coding workspace"
        width="947"
        height="1263"
        loading="lazy"
        class="journey-image"
      />
      <p>{technicalJourney.description}</p>
      <ul class="interests-grid">
        {
          technicalJourney.interests.map((interest) => (
            <li class="card interest-card">
              <strong>{interest.split(":")[0]}:</strong> {interest.split(":")[1]}
            </li>
          ))
        }
      </ul>
      <p>{technicalJourney.approach}</p>
    </div>
  </section>

  <section class="section section--literary">
    <div class="container about-body">
      <h2>{literaryWork.title}</h2>
      <img
        src={`${BASE_URI}/images/literatureAvatar.jpeg`}
        alt="Literary work"
        width="710"
        height="1263"
        loading="lazy"
        class="literary-image"
      />
      <p>{literaryWork.description}</p>
      <p>{literaryWork.content}</p>

      <h3>Published Works</h3>
      <p>{literaryWork.publishedWorks.description}</p>
      <div class="book-grid">
        {
          literaryWork.publishedWorks.books.map((book) => (
            <article class="card book-card">
              <div class="book-title">{book.title}</div>
              <div class="book-series">{book.series}</div>
              <div class="book-rating">{book.rating}</div>
            </article>
          ))
        }
      </div>

      <h3>Other Publications</h3>
      <p>
        {literaryWork.publishedWorks.otherPublications.description}
      </p>
      <ul>
        {
          literaryWork.publishedWorks.otherPublications.publications.map(
            (pub) => <li>{pub}</li>
          )
        }
      </ul>

      <div class="callout influences-callout">
        <strong>Literary Influences:</strong>
        {literaryWork.publishedWorks.influences.literary}<br />
        <strong>Genres:</strong>
        {literaryWork.publishedWorks.influences.genres}<br />
        <strong>Themes:</strong>
        {literaryWork.publishedWorks.influences.themes}
      </div>

      <p>{literaryWork.publishedWorks.goodreads}</p>

      <div class="link-group">
        <a
          href="https://www.goodreads.com/author/show/22082144._"
          target="_blank"
          rel="noopener"
          class="btn btn--ghost"
        >
          View my Goodreads author profile →
        </a>
        <a
          href="https://evanfree.blogspot.com/"
          target="_blank"
          rel="noopener"
          class="btn btn--ghost"
        >
          Visit my blog →
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-body">
      <h2>{bringingItTogether.title}</h2>
      <p>{bringingItTogether.content}</p>
      <p>{bringingItTogether.approach}</p>
      <p>{bringingItTogether.invitation}</p>

      <div class="link-group">
        <a
          href="https://www.linkedin.com/in/lefteris-evangelinos-0370871b9/"
          target="_blank"
          rel="noopener"
          class="btn btn--primary"
        >
          Connect on LinkedIn →
        </a>
        <a
          href="https://github.com/lefos13"
          target="_blank"
          rel="noopener"
          class="btn btn--ghost"
        >
          View GitHub profile →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .about-hero__container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .about-hero__title {
    margin-bottom: 0;
  }

  .about-hero__avatar {
    width: 100%;
    max-width: 16rem;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .about-body > p {
    max-width: 68ch;
  }

  .about-philosophy {
    max-width: 68ch;
    margin: var(--space-6) 0;
  }

  .journey-image,
  .literary-image {
    width: 100%;
    max-width: 32rem;
    max-height: 24rem;
    height: auto;
    margin: var(--space-6) auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    object-fit: cover;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0;
    padding: 0;
    list-style: none;
    max-width: 56rem;
  }

  @media (min-width: 768px) {
    .interests-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .interest-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: 0 !important;
  }

  .interest-card strong {
    color: var(--color-accent);
    font-size: var(--text-base);
  }

  .section--literary {
    background: var(--color-bg-elevated);
  }

  .book-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin: var(--space-6) 0;
  }

  @media (min-width: 768px) {
    .book-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .book-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .book-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-5);
    border-left: 5px solid var(--color-accent);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    transition:
      transform var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .book-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .book-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-heading);
    line-height: var(--leading-snug);
    word-break: normal;
    overflow-wrap: break-word;
  }

  .book-series {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .book-rating {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .influences-callout {
    max-width: 68ch;
    margin: var(--space-6) 0;
    line-height: var(--leading-normal);
  }

  .influences-callout strong {
    color: var(--color-heading);
  }

  .link-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .link-group .btn {
    max-width: 100%;
    white-space: normal;
    text-align: center;
    line-height: var(--leading-snug);
    padding-block: var(--space-3);
  }
</style>
