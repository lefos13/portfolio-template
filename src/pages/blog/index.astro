---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { BASE_URI, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="section">
		<div class="container">
			<h1 class="sr-only">Blog</h1>
			<ul class="post-grid">
				{
					posts.map((post, index) => (
						<li class:list={['post-item', { 'post-item--featured': index === 0 }]}>
							<a
								href={`${BASE_URI}/blog/${post.id}/`}
								class="card card--interactive post-card"
							>
								{post.data.heroImage && (
									<Image
										width={720}
										height={360}
										src={post.data.heroImage}
										alt=""
										loading={index === 0 ? 'eager' : 'lazy'}
									/>
								)}
								<h2 class:list={['post-title', { 'post-title--featured': index === 0 }]}>
									{post.data.title}
								</h2>
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.post-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-grid li {
		margin: 0;
	}

	.post-grid li + li {
		margin-top: 0;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}

	.post-card:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: var(--radius-lg);
	}

	@media (hover: hover) {
		.post-card:hover {
			transform: translateY(-2px);
		}
	}

	.post-card img {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: var(--radius-md);
		margin-bottom: var(--space-4);
	}

	.post-title {
		margin: 0 0 var(--space-2);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		color: var(--color-heading);
		transition: color var(--duration-fast) ease;
	}

	.post-card:hover .post-title {
		color: var(--color-accent);
	}

	.post-date {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.post-item--featured {
			grid-column: 1 / -1;
		}

		.post-title--featured {
			font-size: var(--text-3xl);
		}
	}
</style>
