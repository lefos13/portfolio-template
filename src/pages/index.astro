---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE, BASE_URI } from "../consts";
import content from "../content.json";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="home">
      <section class="hero">
        <div class="hero-content">
          <div class="avatar-container">
            <img
              src={`${BASE_URI}/images/avatar.jpg`}
              alt="Lefteris Evangelinos"
              class="avatar"
            />
          </div>
          <h1 class="name">{content.pages.home.hero.name}</h1>
          <p class="tagline">{content.pages.home.hero.tagline}</p>
          <p class="bio">
            {content.pages.home.hero.bio}
          </p>
          <div class="cta-buttons">
            <!-- <a href="/projects/share-the-ride" class="btn btn-primary">View Projects</a> -->
            <a
              href="https://www.linkedin.com/in/lefteris-evangelinos-0370871b9/"
              target="_blank"
              rel="noopener"
              class="btn btn-primary">LinkedIn Profile</a
            >
            <a
              href="https://github.com/lefos13"
              target="_blank"
              rel="noopener"
              class="btn btn-secondary">GitHub</a
            >
          </div>
        </div>
      </section>

      <section class="expertise">
        <h2>{content.pages.home.expertise.title}</h2>
        <div class="skills-grid">
          {
            content.pages.home.expertise.categories.map((category) => (
              <div class="skill-category">
                <h3>{category.title}</h3>
                <ul>
                  {category.skills.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="featured-projects">
        <h2>{content.pages.home.featuredProjects.title}</h2>
        <p class="projects-note">
          {content.pages.home.featuredProjects.note}
        </p>
        <div class="projects-grid">
          {
            content.pages.home.featuredProjects.projects.map((project) => (
              <article class="project-card">
                <h3>{project.title}</h3>
                <p class="project-description">{project.description}</p>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <a
                  href={`${BASE_URI}/projects/${project.title.toLowerCase().replace(/\s+/g, "-")}`}
                  class="project-link"
                >
                  Learn More →
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="contact-cta">
        <h2>{content.pages.home.contactCTA.title}</h2>
        <p>
          {content.pages.home.contactCTA.description}
        </p>
        <a href={`${BASE_URI}/about`} class="btn btn-primary">Get in Touch</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  /* Hero Section */
  .hero {
    padding: 4rem 0 5rem;
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .avatar-container {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .avatar {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--accent, #4b63ff);
    box-shadow: 0 8px 24px rgba(75, 99, 255, 0.2);
    transition: all 0.3s ease;
  }

  .avatar:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 32px rgba(75, 99, 255, 0.3);
  }

  .name {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    background: linear-gradient(
      135deg,
      var(--accent, #4b63ff) 0%,
      #00a8e8 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 1.5rem;
    color: #555;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .bio {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #666;
    margin-bottom: 2.5rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.9rem 1.8rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-primary {
    background: var(--accent, #4b63ff);
    color: white;
  }

  .btn-primary:hover {
    background: #3a4fd9;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(75, 99, 255, 0.3);
  }

  .btn-secondary {
    background: white;
    color: var(--accent, #4b63ff);
    border: 2px solid var(--accent, #4b63ff);
  }

  .btn-secondary:hover {
    background: var(--accent, #4b63ff);
    color: white;
    transform: translateY(-2px);
  }

  /* Expertise Section */
  .expertise {
    padding: 4rem 0;
    background: #f8f9fa;
    margin: 0 -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
    width: calc(100% + 2rem);
    max-width: 100vw;
    box-sizing: border-box;
  }

  .expertise h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .skill-category {
    background: white;
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .skill-category h3 {
    color: var(--accent, #4b63ff);
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .skill-category ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill-category li {
    padding: 0.5rem 0;
    color: #555;
    border-bottom: 1px solid #eee;
  }

  .skill-category li:last-child {
    border-bottom: none;
  }

  /* Featured Projects */
  .featured-projects {
    padding: 4rem 0;
  }

  .featured-projects h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .projects-note {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
    padding: 1.25rem 1.5rem;
    background: rgba(75, 99, 255, 0.05);
    border-left: 4px solid var(--accent, #4b63ff);
    border-radius: 0.5rem;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .project-card {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 0.75rem;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border-color: var(--accent, #4b63ff);
  }

  .project-card h3 {
    margin-bottom: 1rem;
    color: #333;
    font-size: 1.5rem;
  }

  .project-description {
    color: #666;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    background: #e8eeff;
    color: var(--accent, #4b63ff);
    padding: 0.3rem 0.8rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .project-link {
    color: var(--accent, #4b63ff);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .project-link:hover {
    color: #3a4fd9;
    text-decoration: underline;
  }

  /* Contact CTA */
  .contact-cta {
    padding: 4rem 0 5rem;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .contact-cta h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .contact-cta p {
    font-size: 1.1rem;
    color: #666;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .home {
      padding: 0 1rem;
    }

    .hero {
      padding: 3rem 0 4rem;
    }

    .name {
      font-size: 3rem;
    }

    .tagline {
      font-size: 1.3rem;
    }

    .skills-grid,
    .projects-grid {
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .home {
      padding: 0 0.5rem;
    }

    .hero {
      padding: 2.5rem 0 3rem;
    }

    .avatar {
      width: 150px;
      height: 150px;
    }

    .name {
      font-size: 2.5rem;
      line-height: 1.1;
    }

    .tagline {
      font-size: 1.2rem;
    }

    .bio {
      font-size: 1rem;
      margin-bottom: 2rem;
    }

    .cta-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }

    .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }

    .expertise {
      padding: 3rem 0;
      margin: 0 -0.5rem;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      width: calc(100% + 1rem);
    }

    .expertise h2,
    .featured-projects h2,
    .contact-cta h2 {
      font-size: 2rem;
    }

    .featured-projects,
    .contact-cta {
      padding: 3rem 0;
    }

    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .skill-category {
      padding: 1.5rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .project-card {
      padding: 1.75rem;
    }

    .projects-note {
      margin: 0 auto 2.5rem;
      padding: 1rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 2rem 0;
    }

    .avatar {
      width: 120px;
      height: 120px;
    }

    .name {
      font-size: 2rem;
    }

    .tagline {
      font-size: 1.1rem;
    }

    .bio {
      font-size: 0.95rem;
    }

    .btn {
      padding: 0.8rem 1.5rem;
      font-size: 0.95rem;
    }

    .expertise h2,
    .featured-projects h2,
    .contact-cta h2 {
      font-size: 1.75rem;
    }

    .skill-category,
    .project-card {
      padding: 1.25rem;
    }

    .project-card h3 {
      font-size: 1.3rem;
    }

    .project-description {
      font-size: 0.95rem;
    }
  }
</style>
