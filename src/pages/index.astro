---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, BASE_URI } from "../consts";
import content from "../content.json";
import { projects } from "../data/projects";
import { linkedIn, gitHub } from "../data/social";
import avatarImage from "../assets/avatar.jpg";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="home">
    <section class="section hero">
      <div class="container hero-container">
        <div class="hero-grid">
          <div class="hero-text">
            <h1 class="hero-name">{content.pages.home.hero.name}</h1>
            <p class="hero-tagline lead">{content.pages.home.hero.tagline}</p>
            <p class="hero-bio">{content.pages.home.hero.bio}</p>
            <div class="hero-ctas">
              <a
                href={linkedIn.href}
                target="_blank"
                rel="noopener"
                class="btn btn--primary"
              >LinkedIn Profile</a>
              <a
                href={gitHub.href}
                target="_blank"
                rel="noopener"
                class="btn btn--ghost"
              >GitHub</a>
            </div>
          </div>
          <div class="hero-portrait">
            <div class="hero-portrait-frame">
              <Image
                src={avatarImage}
                alt="Lefteris Evangelinos"
                width={280}
                height={280}
                loading="eager"
                class="hero-avatar"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section expertise">
      <div class="container">
        <div class="section-header">
          <h2>{content.pages.home.expertise.title}</h2>
        </div>
        <div class="skills-grid">
          {
            content.pages.home.expertise.categories.map((category) => (
              <div class="card skill-category">
                <h3 class="skill-category-title">{category.title}</h3>
                <ul class="tag-list">
                  {category.skills.map((skill) => (
                    <li class="tag">{skill}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section featured-projects">
      <div class="container">
        <div class="section-header">
          <h2>{content.pages.home.featuredProjects.title}</h2>
          <p class="projects-note">
            {content.pages.home.featuredProjects.note}
          </p>
        </div>
        <div class="projects-grid">
          {
            projects.map((project, index) => (
              <article
                class:list={[
                  "card",
                  "card--interactive",
                  "project-card",
                  { "project-card--spotlight": index < 3 },
                ]}
              >
                <h3 class="project-title">{project.title}</h3>
                <p class="project-description">{project.description}</p>
                <ul class="tag-list project-tags">
                  {project.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
                <div class="project-footer">
                  <a href={project.href} class="project-link text-link">
                    Learn More →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container">
        <div class="contact-card">
          <h2>{content.pages.home.contactCTA.title}</h2>
          <p class="contact-description">
            {content.pages.home.contactCTA.description}
          </p>
          <a href={`${BASE_URI}/about`} class="btn btn--primary">Get in Touch</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .hero-portrait {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-portrait-frame {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border-radius: var(--radius-pill);
    background: radial-gradient(
      circle at 50% 50%,
      var(--color-glow) 0%,
      var(--color-glow-alt) 65%,
      transparent 100%
    );
  }

  .hero-avatar {
    width: 140px;
    height: 140px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    border: 2px solid var(--color-border-strong);
    box-shadow: var(--shadow-md);
    display: block;
  }

  .hero-name {
    margin-bottom: var(--space-2);
  }

  .hero-tagline {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .hero-bio {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    max-width: 38rem;
    margin-bottom: var(--space-6);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 1023px) {
    .hero-portrait {
      order: -1;
    }

    .hero-text {
      text-align: center;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-bio {
      margin-inline: auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      gap: var(--space-8);
    }

    .hero-avatar {
      width: 280px;
      height: 280px;
    }

    .hero-text {
      text-align: left;
    }

    .hero-ctas {
      justify-content: flex-start;
    }
  }

  /* Expertise */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  @media (min-width: 1100px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-category {
    display: flex;
    flex-direction: column;
  }

  .skill-category-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
    color: var(--color-heading);
  }

  /* Featured Projects */
  .projects-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 48rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    color: var(--color-heading);
  }

  .project-description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .project-tags {
    margin-bottom: var(--space-5);
  }

  .project-footer {
    margin-top: auto;
  }

  .project-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .project-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    z-index: 1;
  }

  .project-card:has(.project-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .project-card:has(.project-link:focus-visible) .project-link {
    outline: none;
  }

  .project-card:hover .project-link {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .project-card--spotlight:first-child {
      grid-column: span 2;
    }

    /* After the full-width first card, cards pair up; stretch a trailing orphan. */
    .project-card:last-child:nth-child(even) {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .project-card {
      grid-column: span 2;
    }

    /* Cards 4+ sit three per row; widen a short last row so it never leaves gaps. */
    .project-card:nth-child(n + 4):nth-child(3n + 1):last-child {
      grid-column: span 6;
    }

    .project-card:nth-child(n + 4):nth-child(3n + 1):nth-last-child(2),
    .project-card:nth-child(n + 4):nth-child(3n + 2):last-child {
      grid-column: span 3;
    }

    .project-card--spotlight {
      grid-column: span 3;
      border-color: var(--color-border-strong);
    }

    .project-card--spotlight .project-title {
      font-size: var(--text-2xl);
    }

    .project-card--spotlight:first-child {
      grid-column: span 6;
      background: linear-gradient(
        135deg,
        var(--color-surface) 0%,
        var(--color-bg-elevated) 100%
      );
    }

    .project-card--spotlight:first-child .project-description {
      font-size: var(--text-base);
      max-width: 52rem;
    }
  }

  /* Contact CTA */
  .contact-card {
    position: relative;
    text-align: center;
    padding: clamp(2.5rem, 2rem + 3vw, 4.5rem) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 0 50px var(--color-glow);
  }

  .contact-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 0%,
      var(--color-glow) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .contact-card h2 {
    position: relative;
    margin-bottom: var(--space-3);
  }

  .contact-description {
    position: relative;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  .contact-card .btn {
    position: relative;
  }
</style>
